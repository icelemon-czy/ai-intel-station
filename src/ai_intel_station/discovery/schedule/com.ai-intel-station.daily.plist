<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS launchd template — replace __UV_PATH__ with `which uv` (e.g. /opt/homebrew/bin/uv)
  and __REPO_ROOT__ with the absolute path to this checkout.

  Easier path: run `uv run research schedule launchd` and follow the printed steps —
  it will render this file with the correct paths and print the exact `cp` + `launchctl`
  commands to run.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ai-intel-station.daily</string>
    <key>ProgramArguments</key>
    <array>
        <string>__UV_PATH__</string>
        <string>run</string>
        <string>research</string>
        <string>discover</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__REPO_ROOT__</string>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/ai-intel-station.daily.out</string>
    <key>StandardErrorPath</key>
    <string>/tmp/ai-intel-station.daily.err</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>